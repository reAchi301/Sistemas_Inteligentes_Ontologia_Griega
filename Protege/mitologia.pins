([Minotauro] of  Criatura

	(estadoVivo FALSE)
	(poseeObjeto [CuernoMinotauro])
	(ubicadoEn [LaberintoCreta]))

([mitologia_Class11] of  %3APAL-CONSTRAINT

	(%3APAL-DESCRIPTION "Ningún personaje puede ser preso de sí mismo")
	(%3APAL-NAME "NoPresoDeSiMismo")
	(%3APAL-RANGE "(defrange ?p :FRAME Personaje)")
	(%3APAL-STATEMENT "(forall ?p (not (presoDe ?p ?p)))"))

([mitologia_Class13] of  %3APAL-CONSTRAINT

	(%3APAL-DESCRIPTION "Un personaje preso está en el mismo lugar que su captor")
	(%3APAL-NAME "CautivoMismoLugar")
	(%3APAL-RANGE "(defrange ?p :FRAME Personaje)\n(defrange ?q :FRAME Personaje)\n(defrange ?l :FRAME Lugar)")
	(%3APAL-STATEMENT "(forall ?p (forall ?q (forall ?l\n                              (=> (and (presoDe ?p ?q) (ubicadoEn ?q ?l))\n                                  (ubicadoEn ?p ?l)))))"))

([mitologia_Class14] of  %3APAL-CONSTRAINT

	(%3APAL-DESCRIPTION "Quien realiza una acción solo puede usar objetos que posee")
	(%3APAL-NAME "AccionConObjetoPropio")
	(%3APAL-RANGE "(defrange ?a :FRAME Accion)\n(defrange ?p :FRAME Personaje)\n(defrange ?o :FRAME Objeto)")
	(%3APAL-STATEMENT "(forall ?a (forall ?p (forall ?o\n                              (=> (and (realizadaPor ?a ?p) (usaObjeto ?a ?o))\n                                  (poseeObjeto ?p ?o)))))"))

