([AlasDedalo] of  Magico

	(otorgaCapacidad [Vuelo])
	(poseidoPor [Dedalo]))

([Andromeda] of  Mortal

	(estadoLibre FALSE)
	(estadoVivo TRUE)
	(presoDe [Ceto])
	(ubicadoEn [CostaEtiopia]))

([Ariadna] of  Mortal
)

([Atenea] of  Dios
)

