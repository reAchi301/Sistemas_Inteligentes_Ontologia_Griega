	(estadoLibre TRUE)
	(tienePreso [Andromeda])
	(ubicadoEn [CostaEtiopia]))

([CostaEtiopia] of  Lugar

	(contieneA
		[Ceto]
		[Andromeda]))

([CuernoMinotauro] of  Arma

	(poseidoPor [Minotauro]))

([Dedalo] of  Mortal

	(estadoVivo TRUE)
	(poseeObjeto [AlasDedalo])
	(presoDe [Minos])
	(ubicadoEn [LaberintoCreta]))

