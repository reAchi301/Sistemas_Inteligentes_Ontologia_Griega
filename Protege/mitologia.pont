		(type INSTANCE)
;+		(allowed-classes Personaje)
;+		(cardinality 0 1)
		(create-accessor read-write))
	(single-slot %3ANAME
		(type STRING)
;+		(cardinality 0 1)
		(create-accessor read-write)))

(defclass Arma "Instancias: HozAcero, EspadaIndestructible, EspadaTeseo, CuernoMinotauro."
	(is-a Objeto)
	(role concrete))

(defclass Proteccion "Instancias: EscudoBronce, EscudoEspejo, EspejoMano."
	(is-a Objeto)
	(role concrete))

(defclass Magico "Instancias: CascoHades, SandaliasAladas, ZurronMagico, HiloAriadna, BridaOro, AnilloInvisibilidad, ConjuroVuelo, AlasDedalo, AlasIcaro."
