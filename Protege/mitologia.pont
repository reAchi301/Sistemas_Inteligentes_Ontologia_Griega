(defclass Dios "Instancias: Zeus, Atenea, Hermes, Hades, Hefesto, Poseidon."
	(is-a Personaje)
	(role concrete))

(defclass SerDivino "Dioses menores. Instancias: Grayas, Ninfas, Nereidas, Doris."
	(is-a Personaje)
	(role concrete))

(defclass Heroe "Personajes controlados o principales. Instancias: Perseo, Teseo, Heracles."
	(is-a Personaje)
	(role concrete))

(defclass Mortal "Instancias: Andromeda, Casiopea, Cefeo, Minos, Ariadna, Dedalo, Icaro."
	(is-a Personaje)
	(role concrete))

(defclass Criatura "Enemigos o monstruos. Instancias: Ceto, Kraken, Medusa, Minotauro, Pegaso."
	(is-a Personaje)
	(role concrete))

(defclass Objeto "Agrupa todos los ítems manipulables por los personajes."
